# Comments are on their own lines on purpose: `docker run --env-file` does not
# strip inline comments, only docker compose does.

# --- vCenter (a read-only role is enough) -----------------------------------
VC_HOST=vcenter.example.local
VC_USER=svc-bcast-monitor@vsphere.local
VC_PASSWORD=change-me
# Alternative to VC_PASSWORD (Docker secret etc.)
# VC_PASSWORD_FILE=/run/secrets/vc_password
# VC_PORT=443
# Label used in alerts (defaults to VC_HOST)
# VC_NAME=Lab vCenter
# Verify the vCenter certificate against your own CA (mount it, see compose file)
# VC_CA_FILE=/certs/ca.pem
# true = skip TLS verification (lab only)
VC_INSECURE=false

# --- detection ----------------------------------------------------------------
# Seconds between polls (vCenter real-time samples are 20 s)
POLL_INTERVAL=60
# 20 s samples looked at per poll, and how many must be above threshold
WINDOW_SAMPLES=3
MIN_HOT_SAMPLES=2
# Broadcasts SENT by one vNIC -> loop source
TX_THRESHOLD_PPS=500
# Broadcasts RECEIVED by one vNIC -> storm victim
RX_THRESHOLD_PPS=1000
# Victim vNICs needed in one network to call it a storm
RX_PORTS_MIN=5
# Add multicast to the counters
INCLUDE_MULTICAST=false
# Regexes (case-insensitive) to ignore VMs / portgroups
# EXCLUDE_VMS=^(nested-esx|wireshark-)
# EXCLUDE_NETWORKS=trunk

# --- alert lifecycle ------------------------------------------------------------
# Re-notify while an incident is active (0 = never)
REMIND_MINUTES=15
# Quiet polls before an incident is "resolved"
RESOLVE_POLLS=2
# Seconds between VM/portgroup inventory refreshes
INVENTORY_REFRESH=300
# Alert when vCenter polling fails this many times in a row
FAIL_ALERT_POLLS=5
STARTUP_MESSAGE=true
LOG_LEVEL=INFO

# --- notifiers (configure one or both) ------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Topic id when posting into a forum-style group
# TELEGRAM_THREAD_ID=
SLACK_WEBHOOK_URL=
